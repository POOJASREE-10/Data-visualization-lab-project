      </column>
      <column caption='Selected Financial Metric' datatype='real' name='[Calculation_0678716912144392]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 0678716911632391]&#13;&#10;&#13;&#10;WHEN &quot;Transaction Value&quot; THEN SUM([amount])&#13;&#10;WHEN &quot;Total Debt&quot; THEN SUM([total_debt])&#13;&#10;WHEN &quot;Yearly Income&quot; THEN SUM([yearly_income])&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Credit Category' datatype='string' name='[Calculation_0678716915650570]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [credit_score] &gt;= 750 THEN &quot;Excellent&quot;&#13;&#10;ELSEIF [credit_score] &gt;= 700 THEN &quot;Good&quot;&#13;&#10;ELSEIF [credit_score] &gt;= 650 THEN &quot;Fair&quot;&#13;&#10;ELSEIF [credit_score] &gt;= 600 THEN &quot;Poor&quot;&#13;&#10;ELSE &quot;Very Poor&quot;&#13;&#10;END' />
      </column>
