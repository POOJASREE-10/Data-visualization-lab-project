    <worksheet name='Waste Percentage Analysis'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Food_Waste_Dataset (Food_Waste_Prediction_Dataset (1))' name='federated.09ldv2f1d6a0s616smp011lkswck' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Minimum Waste (kg)' datatype='real' name='[Parameter 1964043765256193]' param-domain-type='range' role='measure' type='quantitative' value='32.0'>
              <calculation class='tableau' formula='32.0' />
              <range granularity='1.0' max='100.0' min='0.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.09ldv2f1d6a0s616smp011lkswck'>
            <column caption='Waste Percentage' datatype='real' name='[Calculation_1964043763961856]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Waste_Amount_kg]) / SUM([Prepared_Quantity]) * 100' />
            </column>
            <column caption='Waste Threshold Filter' datatype='boolean' name='[Calculation_1964043765739522]' role='measure' type='nominal'>
              <calculation class='tableau' formula='SUM([Waste_Amount_kg]) &gt;= [Parameters].[Parameter 1964043765256193]' />
            </column>
            <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Prepared Quantity' datatype='integer' name='[Prepared_Quantity]' role='measure' type='quantitative' />
            <column caption='Restaurant Name' datatype='string' name='[Restaurant_Name]' role='dimension' type='nominal' />
            <column caption='Waste Amount kg' datatype='real' name='[Waste_Amount_kg]' role='measure' type='quantitative' />
            <column-instance column='[City]' derivation='None' name='[none:City:nk]' pivot='key' type='nominal' />
            <column-instance column='[Restaurant_Name]' derivation='None' name='[none:Restaurant_Name:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1964043763961856]' derivation='User' name='[usr:Calculation_1964043763961856:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1964043765739522]' derivation='User' name='[usr:Calculation_1964043765739522:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.09ldv2f1d6a0s616smp011lkswck].[none:City:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:City:nk]' member='&quot;Bengaluru&quot;' />
