      <aliases enabled='yes' />
      <column caption='Waste Percentage' datatype='real' name='[Calculation_1964043763961856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Waste_Amount_kg]) / SUM([Prepared_Quantity]) * 100' />
      </column>
      <column caption='Waste Threshold Filter' datatype='boolean' name='[Calculation_1964043765739522]' role='measure' type='nominal'>
